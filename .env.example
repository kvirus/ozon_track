TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890

# Прокси только для Telegram Bot API (если api.telegram.org недоступен)
# socks5://user:pass@host:1080, socks5h://host:1080 или http://host:8080
TELEGRAM_PROXY=

# Прокси для Chromium/Ozon, если IP сервера заблокирован antibot Ozon.
# Нужен чистый резидентный IP. Формат тот же.
OZON_PROXY=

# Ссылка на отслеживание. Номер извлекается из ?track=
OZON_TRACK_URL=https://tracking.ozon.ru/?track=0000000000
# Альтернатива: задать номер напрямую
# OZON_TRACK_NUMBER=0000000000

# Раз в час
POLL_INTERVAL_SECONDS=3600
NAV_TIMEOUT_SECONDS=90
# false = обычный Chromium под Xvfb (иногда лучше проходит antibot Ozon)
HEADLESS=true
# Сообщение о запуске контейнера + сводка при первом запуске
NOTIFY_ON_START=true

STATE_FILE=/data/state.json
BROWSER_DIR=/data/browser
TZ=Europe/Moscow
LOG_LEVEL=INFO
